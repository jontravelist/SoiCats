{
  "expo": {
    "name": "Soi Cats",
    "slug": "soi-cats",
    "scheme": "soicats",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8EE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.soicats.app",
      "config": {
        "googleMapsApiKey": "$EXPO_PUBLIC_GOOGLE_MAPS_API_KEY"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Soi Cats uses your camera so you can photograph cats you meet.",
        "NSPhotoLibraryAddUsageDescription": "Soi Cats saves stickers you unlock to your camera roll.",
        "NSLocationWhenInUseUsageDescription": "Soi Cats uses your location to identify which neighbourhood cat you've spotted.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.soicats.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8EE"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "$EXPO_PUBLIC_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Soi Cats to use the camera so you can photograph cats."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Soi Cats uses your location to identify nearby cats."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Soi Cats needs access to your photos so you can pick cat photos to upload."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "TODO-set-via-eas-init"
      }
    }
  }
}
